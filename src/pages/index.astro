---
import '../styles/voyage.css';
import Analytics from '@vercel/analytics/astro';
import CurrentArrow from '../components/CurrentArrow.astro';
import ViewGlyph from '../components/ViewGlyph.astro';
const registrationUrl = 'https://luma.com/60zajedj';
const pageTitle = 'Hackathoni — Leave the ordinary ashore.';
const pageDescription = 'A 12-hour solo hackathon on two houseboats in Kerala’s backwaters. 21–22 November 2026, Alappuzha. By Devin × TinkerHub.';
const canonicalUrl = new URL('/', Astro.site);
const shareImageUrl = new URL('/assets/brand/hackathoni-social-v1.jpg', Astro.site);
const shareImageAlt = 'Hackathoni: 12 hours, two houseboats, a night worth making. A lantern-lit houseboat on Kerala’s backwaters at sunset. 21–22 November 2026, Alappuzha.';
const faqs = [
 ['Is this a team hackathon?', 'Hackathoni is a solo hackathon. You build your own project while sharing the experience with other builders.'],
 ['When and where?', 'Alappuzha, Kerala. Boarding: Saturday, 21 November 2026 at 15:30. Docking: Sunday, 22 November at 09:30. The exact boarding point will be announced.'],
 ['Is entry free?', 'Entry is free. Register through Luma; applications are reviewed to select 50 builders. Your place is confirmed when your registration is approved.'],
 ['What can I build?', 'Bring your own idea and build a project with Devin. You’ll have twelve hours of hacking, followed by demos and judging. The detailed challenge and judging guidelines will be shared before the event.'],
 ['What about Wi-Fi, power, meals, and rest?', 'Food and refreshments are part of the night. Details about connectivity, charging, rest arrangements and accessibility will be shared before the event. Contact us if you have a specific requirement.'],
 ['What are the prizes?', 'Devin Max plans for winners, with more prizes to be announced. Award categories and terms are still to come.'],
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<meta name="theme-color" content="#102b35"/>
<meta name="description" content={pageDescription}/>
<link rel="canonical" href={canonicalUrl}/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Hackathoni"/>
<meta property="og:url" content={canonicalUrl}/>
<meta property="og:title" content={pageTitle}/>
<meta property="og:description" content={pageDescription}/>
<meta property="og:image" content={shareImageUrl}/>
<meta property="og:image:type" content="image/jpeg"/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content={shareImageAlt}/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={pageTitle}/>
<meta name="twitter:description" content={pageDescription}/>
<meta name="twitter:image" content={shareImageUrl}/>
<meta name="twitter:image:alt" content={shareImageAlt}/>
<title>{pageTitle}</title>
<link rel="icon" href="/assets/brand/favicon.png?v=transparent-2" type="image/png" sizes="64x64"/>
<link rel="icon" href="/assets/brand/favicon.svg?v=transparent-2" type="image/svg+xml" sizes="any"/>
<link rel="preload" href="/assets/houseboat-light.glb?v=water-3" as="fetch" type="model/gltf-binary" crossorigin/>
<link rel="preload" href="/assets/shore-sunset.webp" as="image" fetchpriority="high" crossorigin/>
<link rel="preload" href="/assets/draco/draco_decoder.wasm" as="fetch" type="application/wasm" crossorigin/>
<link rel="preload" href="/assets/fonts/fraunces-soft-latin.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="preload" href="/assets/fonts/cormorant-garamond-bold-italic-latin.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="preload" href="/assets/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin/>
</head>
<body data-stop="0">
<a href="#voyage" class="skip">Skip to the voyage</a>
<div class="world" id="world" aria-hidden="true"><canvas id="lake"></canvas></div>
<template id="still-scene"><div class="world-fallback"><picture><source media="(max-width:760px)" srcset="/assets/voyage-poster-mobile.webp"/><img src="/assets/voyage-poster.webp" alt="" width="1440" height="900"/></picture></div></template>
<div class="film-grain" aria-hidden="true"></div><div class="reading-shade" aria-hidden="true"></div>
<header class="masthead">
 <a class="wordmark" href="#jetty" data-go="0" aria-label="Hackathoni, return to the jetty"><img crossorigin="anonymous" class="brand-emblem" src="/assets/brand/hackathoni-emblem.webp" width="62" height="40" alt="" aria-hidden="true"/><span>hacka<em>thoni</em><small class="translation-note"><span class="translation-roman">thōni</span><span class="translation-divider" aria-hidden="true">/</span><span lang="ml">തോണി</span><span class="translation-meaning">noun · a boat.</span></small></span></a>
 <div class="edition"><span>21—22 NOV 2026</span><span>ALAPPUZHA, KERALA</span></div>
 <div class="mast-actions"><button class="guide-open">Field guide <span class="guide-mark" aria-hidden="true"><i></i><i></i><i></i></span></button><a href={registrationUrl} class="boarding-link registration-link" target="_blank" rel="noopener">Register <CurrentArrow/></a></div>
</header>
<div class="coordinates"><i></i><span>9.50° N &nbsp; 76.34° E</span><span class="coordinates-line"></span><span id="scene-label">THE JETTY / LATE AFTERNOON</span></div>
<main class="voyage" id="voyage" aria-label="An interactive voyage through five chapters. Scroll vertically on mobile, drag the boat sideways to turn it, or use the chapter buttons and arrow keys.">
 <section class="stop jetty" id="jetty" aria-labelledby="jetty-title">
  <div class="chapter-copy"><p class="overline">21—22 NOVEMBER 2026 · ALAPPUZHA</p><h1 id="jetty-title">A night <em>worth making.</em></h1><p class="chapter-description">Two houseboats. Twelve hours. An idea that won’t let you sleep.</p></div>
  <button class="voyage-cta stage-cta" data-go="1"><span>Step aboard</span><CurrentArrow/></button>
  <div class="jetty-facts"><span>SOLO · FREE ENTRY</span></div>
 </section>
 <section class="stop aboard" id="aboard" aria-labelledby="aboard-title">
  <div class="chapter-copy"><p class="overline">01 / THE FLOATING WORKSHOP</p><h2 id="aboard-title">A workshop, <em>afloat.</em></h2><p class="chapter-description">Your own project. Good company. Water all around.</p><p class="tiny-note">Illustrative miniature · layout may differ.</p></div>
  <div class="inspection-caption" aria-live="polite"><p class="overline">FROM THE DECK</p><h3 id="inspection-title">Good company.</h3><p id="inspection-description">Different ideas. A shared night.</p></div>
  <div class="aboard-toolbar">
   <button class="roof-control" id="roof-button" aria-pressed="true" aria-label="Lower the canopy"><svg viewBox="0 0 42 40" aria-hidden="true"><path class="canopy-lift" d="M7 17C7 1 35 1 35 17H7Z"/><path d="M4 31h34l-5 5H9Z"/><path class="canopy-thread" d="M12 21v6M30 21v6"/></svg><span><small>THE CANOPY</small><b id="roof-label">Lower it</b></span></button>
   <div class="workshop-views" role="group" aria-label="Explore the workshop views" hidden>
    <span class="view-caption">A CHANGE OF PERSPECTIVE</span>
    <div>{['Whole boat','Company','Workspace'].map((label,i)=><button data-inspect={i} aria-pressed={i===0?'true':'false'}><ViewGlyph view={i}/><span><small>0{i+1}</small>{label}</span></button>)}</div>
   </div>
  </div>

 </section>
 <section class="stop midnight" id="midnight" aria-labelledby="midnight-title">
  <div class="midnight-clock" aria-hidden="true">00:00<span>ON THE BACKWATERS</span></div>
  <div class="chapter-copy"><h2 id="midnight-title">Keep a little <em>light on.</em></h2><p class="chapter-description">For the idea that’s almost there.</p></div>
  <div class="water-invitation"><p>TOUCH THE WATER. STAY A WHILE.</p></div>
 </section>
 <section class="stop morning" id="morning" aria-labelledby="morning-title">
  <div class="chapter-copy"><p class="overline">03 / FIRST LIGHT</p><h2 id="morning-title">Take something <em>new ashore.</em></h2><p class="chapter-description">By morning, the idea is yours to show.</p></div>
  <button class="voyage-cta stage-cta" data-go="4"><span>Find your place aboard</span><CurrentArrow/></button>
  <div class="morning-note"><span lang="ml">പുലരി</span><p>PULARI / FIRST LIGHT</p></div>
 </section>
 <section class="stop boarding" id="boarding" aria-labelledby="boarding-title">
  <div class="boarding-heading"><p class="overline"><span class="folio-number">04</span> / Your place</p><h2 id="boarding-title"><span class="title-line title-line--first">Leave the</span><em class="title-line title-line--middle">ordinary</em><span class="title-line title-line--last">ashore.</span></h2></div>
  <article class="ticket" id="boarding-notes" aria-labelledby="boarding-card-title">
   <div class="ticket-top"><span>Alappuzha, Kerala</span></div>
   <h3 id="boarding-card-title">A place on the water.</h3>
   <div class="ticket-dates"><dl class="ticket-grid"><div><dt>We set off</dt><dd><b>21</b><span class="date-month">Nov</span><time datetime="2026-11-21T15:30:00+05:30">15:30</time></dd></div><div><dt>Back ashore</dt><dd><b>22</b><span class="date-month">Nov</span><time datetime="2026-11-22T09:30:00+05:30">09:30</time></dd></div></dl><CurrentArrow class="date-current"/></div>
   <p class="ticket-format">Two houseboats <i></i> Solo <i></i> Free entry</p>
   <p class="ticket-mobile-date">21—22 November · Alappuzha</p>
   <a class="registration-cta registration-link" aria-label="Register for Hackathoni on Luma" href={registrationUrl} target="_blank" rel="noopener" aria-describedby="admission-note"><span>Make it your night</span><CurrentArrow/></a>
   <small class="admission-note" id="admission-note">Free entry · Registration subject to approval.</small>
   <div class="ticket-secondary"><button class="guide-open" id="boarding-reveal">The practical details <span aria-hidden="true">↗</span></button><a class="calendar-cta" href="/hackathoni.ics" download>Save the date</a></div>
  </article>
 </section>
</main>
<div class="voyage-tools"><button id="sound-toggle" aria-pressed="true" aria-label="Mute water ambience"><svg viewBox="0 0 20 16" aria-hidden="true"><path d="M2 5h4l5-4v14l-5-4H2Z" fill="none" stroke="currentColor"/><path d="M14 4q6 4 0 8" fill="none" stroke="currentColor"/></svg><span id="sound-text">SOUND ON</span></button><span id="loading-note" aria-live="polite">SETTING SAIL</span></div>
<footer class="voyage-footer"><div class="route-topline"><span>THE VOYAGE</span><div class="sponsor-logos" aria-label="Devin and TinkerHub"><img class="sponsor-devin" src="/assets/brand/devin-white.webp" width="600" height="160" alt="Devin"/><span aria-hidden="true">×</span><img class="sponsor-tinkerhub" src="/assets/brand/tinkerhub-white.webp" width="600" height="98" alt="TinkerHub"/></div><span class="voyage-count"><b id="chapter-number">01</b> / 05</span></div><nav class="route" aria-label="Voyage chapters"><div class="route-line" role="progressbar" aria-label="Voyage progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i id="route-progress"></i></div><button data-go="0" aria-current="step"><i></i><span>Jetty</span><small>15:30</small></button><button data-go="1"><i></i><span>Aboard</span><small>Settle in</small></button><button data-go="2"><i></i><span>Midnight</span><small>Build</small></button><button data-go="3"><i></i><span>First light</span><small>Dawn</small></button><button data-go="4"><i></i><span>Your place</span><small>09:30</small></button></nav><div class="chapter-arrows"><button id="previous-stop" aria-label="Previous chapter" disabled><CurrentArrow reverse/></button><span class="nav-divider" aria-hidden="true"></span><button id="next-stop" aria-label="Next chapter"><CurrentArrow/></button></div></footer>
<dialog class="field-guide" id="field-guide" aria-labelledby="guide-title">
 <div class="guide-inner">
  <header class="guide-header"><span>HACKATHONI <i>/</i> FIELD GUIDE</span><div><a class="guide-register registration-link" href={registrationUrl} target="_blank" rel="noopener">Register <CurrentArrow/></a><button id="guide-close" aria-label="Close field guide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></div></header>
  <div class="guide-layout">
   <div class="guide-cover">
    <p class="overline">ALAPPUZHA, KERALA <span>VOL. 01 / 2026</span></p>
    <h2 id="guide-title">Notes from<br/>the <em>water.</em></h2>
    <p class="guide-intro">Two houseboats. Fifty builders.<br/>Twelve hours to follow an idea.</p>
    <div class="guide-chart" aria-label="The night begins with a cruise, continues with building, and ends with demos.">
     <svg viewBox="0 0 360 280" aria-hidden="true"><g class="chart-contours"><path d="M-20 32C118-12 120 142 250 108S386 126 392 240"/><path d="M-20 44C114 2 121 154 252 120S375 138 380 240"/><path d="M-20 56C110 16 122 166 254 132S364 150 368 240"/><path d="M-20 184C48 145 88 274 208 240S300 254 350 302"/><path d="M-20 196C48 157 88 286 208 252S300 266 350 314"/></g><path class="chart-route" d="M35 94C118 58 137 238 237 195S334 194 320 250"/><circle cx="35" cy="94" r="5"/><circle cx="164" cy="195" r="5"/><circle cx="320" cy="250" r="5"/></svg>
     <span class="chart-label chart-label--start"><b>01</b> Set off</span><span class="chart-label chart-label--middle"><b>02</b> Make something</span><span class="chart-label chart-label--end"><b>03</b> Bring it ashore</span>
    </div>
    <div class="guide-edition"><span lang="ml">തോണി</span><p>thōni / a boat.<br/>A way a little further from ordinary.</p></div>
   </div>
   <div class="guide-reading">
    <section class="guide-essential" aria-labelledby="guide-essentials-title">
     <p class="guide-section-label">01 / THE NIGHT AHEAD</p>
     <h3 id="guide-essentials-title">Come curious.<br/><em>Leave with something.</em></h3>
     <div class="guide-facts"><div><span>BOARDING · SATURDAY</span><b>21 <em>November</em></b><time datetime="2026-11-21T15:30:00+05:30">15:30</time></div><div><span>ASHORE · SUNDAY</span><b>22 <em>November</em></b><time datetime="2026-11-22T09:30:00+05:30">09:30</time></div></div>
     <p class="guide-build-note"><strong>12 hours of hacking.</strong> A cruise to begin, a night to build, and demos the next morning.</p>
     <div class="guide-meta"><span>Solo · Free entry</span><span>Devin × TinkerHub</span></div>
     <a class="guide-apply registration-link" href={registrationUrl} target="_blank" rel="noopener"><span>Find your place aboard<small>Register on Luma · Selection required</small></span><CurrentArrow/></a>
    </section>
    <section class="guide-questions" aria-labelledby="guide-questions-title"><p class="guide-section-label">02 / BEFORE YOU PACK</p><h3 id="guide-questions-title">A few things to know.</h3><div class="guide-faqs">{faqs.map(([question,answer],i)=><details><summary><span>0{i+1}</span>{question}<b aria-hidden="true">+</b></summary><p>{answer}</p></details>)}</div></section>
    <div class="guide-contact"><p class="guide-section-label">03 / A PERSON, NOT A HELPDESK</p><h3>Talk to Vaishakh.</h3><p>A question about the night? Get in touch.</p><a href="https://wa.me/917907649864" target="_blank" rel="noopener">Say hello on WhatsApp <CurrentArrow/></a></div>
    <a class="guide-apply guide-register-final registration-link" href={registrationUrl} target="_blank" rel="noopener"><span>Register for the night<small>Free entry · Selection through Luma</small></span><CurrentArrow/></a>
    <p class="guide-footnote">The voyage is an artistic preview. The exact boarding point and practical details will be shared before the event.</p>
    <button class="back-water" id="guide-return">Back to the water <CurrentArrow/></button>
   </div>
  </div>
 </div>
</dialog>
<script src="../scripts/voyage.js"></script>
<Analytics />
</body></html>
